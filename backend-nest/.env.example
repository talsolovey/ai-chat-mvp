# Auth — must be at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-secret

# MongoDB connection string. Atlas is REQUIRED for the tutor knowledge base:
# local MongoDB does not support Atlas Vector Search. Use your Atlas SRV URI.
# Example: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/chat?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/chat

PORT=4000

# OpenAI — required. The key is read from the environment and never logged.
OPENAI_API_KEY=sk-your-key-here
# Optional overrides (defaults shown).
OPENAI_MODEL=gpt-4o-mini-2024-07-18
# Embeddings for the knowledge base (Anthropic has no embeddings API).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=256
OPENAI_TEMPERATURE=0.7
