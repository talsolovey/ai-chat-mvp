# Auth — must be at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-secret

# MongoDB connection string (replica set required for transactions).
MONGO_URI=mongodb://localhost:27017/chat?replicaSet=rs0&directConnection=true

PORT=4000

# OpenAI — required. The key is read from the environment and never logged.
OPENAI_API_KEY=sk-your-key-here
# Optional overrides (defaults shown).
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_MAX_TOKENS=256
OPENAI_TEMPERATURE=0.7
